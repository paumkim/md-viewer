"""

THEME_TOGGLE_JS = """
<script>
(function(){
  var btn = document.getElementById('theme-toggle');
  if (!btn) return;
  btn.addEventListener('click', function(){
    var body = document.body;
    if (body.classList.contains('dark-mode')) {
      body.classList.remove('dark-mode');
      body.classList.add('light-mode');
      localStorage.setItem('md-viewer-theme', 'light');
    } else {
      body.classList.remove('light-mode');
      body.classList.add('dark-mode');
      localStorage.setItem('md-viewer-theme', 'dark');
    }
  });
  // Restore saved preference
  var saved = localStorage.getItem('md-viewer-theme');
  if (saved === 'dark') {
    document.body.classList.add('dark-mode');
  } else if (saved === 'light') {
    document.body.classList.add('light-mode');
  }
})();
</script>"""

_IMG_SRC_RE = re.compile(r'<img[^>]+src="([^"]+)"', re.IGNORECASE)
_FENCE_RE = re.compile(r'^( {0,3})(`{3,}|~{3,})', re.MULTILINE)
_INDENT_CODE_RE = re.compile(r'^(?:    |\t)', re.MULTILINE)


def _has_code_blocks(md_text):
    """Return True if the markdown looks like it contains code blocks.

    Fenced code (``` or ~~~) is detected reliably. Indented code is detected
    with a conservative 4-space/tab heuristic so we never disable highlighting
    on a doc that has real code (visual regression is the priority here).
    """
    if _FENCE_RE.search(md_text):
        return True
    return bool(_INDENT_CODE_RE.search(md_text))


def _copy_images(html, md_path, output_dir):
    """Find relative image references in HTML, copy images to output_dir, rewrite src paths."""
    md_dir = md_path.parent.resolve()
    copied = {}

    def _replace(match):
        src = match.group(1)
        # Skip absolute URLs, data URIs, and anchor links
        if src.startswith(('http://', 'https://', 'data:', '#')):
            return match.group(0)
        if src in copied:
            return f'src="{copied[src]}"'

        img_path = (md_dir / src).resolve()
        if not img_path.exists():
            return match.group(0)

        # Copy image to output dir, preserving filename (dedupe if needed)
        dest_path = output_dir / img_path.name
        counter = 1
        while dest_path.exists() and dest_path != img_path:
            dest_path = output_dir / f"{img_path.stem}_{counter}{img_path.suffix}"
            counter += 1

        shutil.copy2(img_path, dest_path)
        copied[src] = dest_path.name
        return f'src="{dest_path.name}"'

    # Fast path: no <img tags at all — skip the regex entirely
    if "<img" not in html:
        return html
    return _IMG_SRC_RE.sub(_replace, html)


def render(md_path, *, dark_mode=False):
    """Convert .md file to HTML string."""
    from markdown import markdown as md_convert

    md_text = md_path.read_text(encoding="utf-8")
    extensions = ["extra", "tables", "fenced_code"]
    if _has_code_blocks(md_text):
        extensions = ["extra", "codehilite", "tables", "fenced_code"]
    html_body = md_convert(md_text, extensions=extensions)
    title = md_path.stem.replace("-", " ").replace("_", " ").title()

    # Determine initial theme class
    if dark_mode:
        theme_class = ' class="dark-mode"'
    else:
        theme_class = ""

    html = f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="color-scheme" content="light dark">
<title>{title}</title>
<style>{STYLE}</style>
</head>
<body{theme_class}>
<button id="theme-toggle" title="Toggle dark/light mode">🌓</button>
{html_body}
{THEME_TOGGLE_JS}
</body>
</html>"""

    return html


def main():
    parser = argparse.ArgumentParser(
        description="Convert a .md file to styled HTML and open in Firefox.",
        usage="%(prog)s [--stdout] [--dark] file.md"
    )
    parser.add_argument("file", nargs="?", help="Path to the .md file")
    parser.add_argument("--stdout", "-o", action="store_true",
                        help="Print HTML to stdout instead of opening Firefox")
    parser.add_argument("--dark", action="store_true",
                        help="Start in dark mode")
    args = parser.parse_args()

    if not args.file:
        parser.print_help()
        sys.exit(1)

    md_path = pathlib.Path(args.file)
    if not md_path.exists():
        print(f"Error: file not found: {md_path}", file=sys.stderr)
        sys.exit(1)

    html = render(md_path, dark_mode=args.dark)

    if args.stdout:
        sys.stdout.write(html)
        return

    # Copy images referenced in the markdown to a temp dir alongside the HTML
    tmp_name = f"md_{md_path.stem}"
    tmp_dir = pathlib.Path("/tmp") / tmp_name
    tmp_dir.mkdir(exist_ok=True)
    html = _copy_images(html, md_path, tmp_dir)

    # Write HTML to temp dir and open in Firefox
    tmp_path = tmp_dir / "index.html"
    tmp_path.write_text(html, encoding="utf-8")

    # Find a suitable browser
    for browser in ["firefox", "xdg-open"]:
        try:
            subprocess.run([browser, str(tmp_path.resolve())], check=True)
            return
        except FileNotFoundError:
            continue

    print("Error: Firefox not found in PATH. Use --stdout to output HTML.", file=sys.stderr)
    sys.exit(1)


if __name__ == "__main__":
    main()
