@media (prefers-color-scheme: dark) {
  body:not(.light-mode) #theme-toggle {
    background: #21262d; border-color: #30363d; color: #c9d1d9;
  }
  body:not(.light-mode) #theme-toggle:hover {
    background: #30363d;
