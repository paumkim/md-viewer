#!/usr/bin/env python3
"""
Convert a .md file to styled HTML and open in Firefox.

Usage:
  md2html file.md              # Convert and open in Firefox
  md2html --stdout file.md     # Print HTML to stdout (pipe, redirect)
  md2html --help               # Show this help
"""
import sys, pathlib, subprocess, argparse, re, shutil

STYLE = """
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
  max-width: 820px; margin: 40px auto; padding: 0 20px;
  line-height: 1.6; color: #1f2328; background: #fff;
  transition: background 0.3s, color 0.3s;
}
pre { background: #f6f8fa; padding: 16px; border-radius: 6px; overflow-x: auto; margin: 16px 0; }
code { background: #f6f8fa; padding: 2px 6px; border-radius: 4px; font-size: 0.9em; }
pre code { background: none; padding: 0; }
table { border-collapse: collapse; width: 100%; margin: 16px 0; }
th, td { border: 1px solid #d0d7de; padding: 8px 12px; text-align: left; }
th { background: #f6f8fa; font-weight: 600; }
img { max-width: 100%; }
blockquote { border-left: 4px solid #d0d7de; padding-left: 16px; margin: 16px 0; color: #656d76; }
h1, h2, h3 { border-bottom: 1px solid #d0d7de; padding-bottom: 8px; margin: 24px 0 16px; }
h1 { font-size: 2em; } h2 { font-size: 1.5em; } h3 { font-size: 1.25em; }
p { margin: 16px 0; }
a { color: #0969da; }
ul, ol { padding-left: 24px; margin: 16px 0; }
li { margin: 4px 0; }
hr { border: none; border-top: 1px solid #d0d7de; margin: 24px 0; }

/* Dark mode — auto-detect */
@media (prefers-color-scheme: dark) {
  body:not(.light-mode) {
    color: #c9d1d9; background: #0d1117;
  }
  body:not(.light-mode) pre { background: #161b22; }
  body:not(.light-mode) code { background: #161b22; }
  body:not(.light-mode) th { background: #161b22; }
  body:not(.light-mode) blockquote { border-color: #484f58; color: #8b949e; }
  body:not(.light-mode) h1, body:not(.light-mode) h2, body:not(.light-mode) h3 { border-color: #30363d; }
  body:not(.light-mode) hr { border-color: #30363d; }
  body:not(.light-mode) th, body:not(.light-mode) td { border-color: #30363d; }
  body:not(.light-mode) a { color: #58a6ff; }
}

/* Dark mode — manual toggle */
body.dark-mode {
  color: #c9d1d9; background: #0d1117;
}
body.dark-mode pre { background: #161b22; }
body.dark-mode code { background: #161b22; }
body.dark-mode th { background: #161b22; }
body.dark-mode blockquote { border-color: #484f58; color: #8b949e; }
body.dark-mode h1, body.dark-mode h2, body.dark-mode h3 { border-color: #30363d; }
body.dark-mode hr { border-color: #30363d; }
body.dark-mode th, body.dark-mode td { border-color: #30363d; }
body.dark-mode a { color: #58a6ff; }

/* Light mode override */
body.light-mode {
  color: #1f2328; background: #fff;
}
body.light-mode pre { background: #f6f8fa; }
body.light-mode code { background: #f6f8fa; }
body.light-mode th { background: #f6f8fa; }
body.light-mode blockquote { border-color: #d0d7de; color: #656d76; }
body.light-mode h1, body.light-mode h2, body.light-mode h3 { border-color: #d0d7de; }
body.light-mode hr { border-color: #d0d7de; }
body.light-mode th, body.light-mode td { border-color: #d0d7de; }
body.light-mode a { color: #0969da; }

/* Toggle button */
#theme-toggle {
  position: fixed; top: 12px; right: 12px; z-index: 100;
  background: #f0f3f6; border: 1px solid #d0d7de; border-radius: 20px;
  padding: 6px 14px; font-size: 13px; cursor: pointer;
  color: #1f2328; transition: background 0.2s, border-color 0.2s;
}
#theme-toggle:hover { background: #d0d7de; }
